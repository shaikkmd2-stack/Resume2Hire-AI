# ==========================================
# Resume2Hire AI - Firebase Configuration
# ==========================================
# Copy this file to .env and replace placeholders with your Firebase project credentials.
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web App

VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Backend / Mock Mode Configuration
# Set to 'false' to use real Firebase services, or 'true' to force mock mode
VITE_USE_MOCK_FALLBACK="false"

# n8n AI Automation Webhook Boundary (Configurable when ready)
VITE_N8N_WEBHOOK_URL="https://n8n.internal.resume2hire.ai/webhook"
